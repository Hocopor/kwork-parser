# ----------------------------------------------------------------------------
# KWORK PARSER & VK BOT — переменные окружения
# Скопируйте этот файл в .env и заполните значения.
# ----------------------------------------------------------------------------

# Порт, на котором слушает сервер (по умолчанию 3001)
PORT=3001

# --- Уровень логирования ---
# error — только ошибки (по умолчанию; журнал чистый, диск не нагружается)
# warn  — ошибки + предупреждения (блокировки/капча, ночной режим)
# all   — всё подряд (для отладки)
LOG_LEVEL=error

# --- Прокси для запросов к Kwork (с ротацией) ---
# IP сервера/VPS Kwork часто блокирует (403/капча Qrator). Укажите ОДИН или
# НЕСКОЛЬКО прокси через запятую — запросы распределяются по ним (round-robin),
# при блоке полоса временно отключается, запрос повторяется через другой прокси.
# Формат каждого: http://user:pass@host:port  (или http://host:port без авторизации)
# Несколько: KWORK_PROXY=http://u:p@host1:port1,http://u:p@host2:port2
# Если пусто — запросы идут напрямую с IP сервера.
KWORK_PROXY=

# --- Авторизация панели управления ---
# SHA-256 ХЭШ пароля (не сам пароль!). Если пусто — панель открыта без пароля.
# Сгенерировать хэш для своего пароля:
#   node -e "console.log(require('crypto').createHash('sha256').update('ВАШ_ПАРОЛЬ').digest('hex'))"
DASHBOARD_PASSWORD_HASH=

# --- Интеграция с VK ---
# Токен доступа сообщества (Управление сообществом → Работа с API → Ключи доступа)
VK_TOKEN=

# ID получателя уведомлений. Укажите свой числовой VK ID (vk.com/idXXXXX).
# Можно несколько через запятую. Если задан VK_GROUP_CHAT_ID — он в приоритете.
VK_ADMIN_IDS=

# Peer ID групповой беседы для уведомлений (необязательно).
VK_GROUP_CHAT_ID=

# Код подтверждения Callback API (только если используете команды боту из VK).
VK_CONFIRM_TOKEN=
